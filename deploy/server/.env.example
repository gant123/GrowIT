# Copy to .env next to docker-compose.yml and fill in. .env is gitignored.
# Docker Compose reads the first block; the rest is passed to the app as-is
# (double underscore = nested config key, e.g. Jwt__Key -> Jwt:Key).

# --- Compose settings ---
GROWIT_IMAGE=growit-client:latest
CLIENT_PORT=5180
DB_NETWORK=supabase_default
TUNNEL_NETWORK=proxy

# --- Database (the server's PostgreSQL, reached by container name) ---
# Connect straight to Postgres on 5432. Avoid Supabase's transaction pooler (6543).
ConnectionStrings__DefaultConnection=Host=supabase-db;Port=5432;Database=growit;Username=growit;Password=change-me
Database__AutoMigrate=false

# --- Public URL ---
ClientUrl=https://growit.now
Cors__AllowedOrigins__0=https://growit.now

# --- Secrets ---
Jwt__Key=
SuperAdmin__Email=
SyncfusionLicense=
Email__ResendApiKey=
Email__ResendBaseUrl=https://api.resend.com
Email__FromEmail=info@moemedia.cloud
Email__FromName=grow.IT
Email__TimeoutMs=10000
Email__DevFileFallbackEnabled=false

# --- Stripe (optional) ---
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__Plans__Pro__MonthlyPriceId=
Stripe__Plans__Pro__YearlyPriceId=
Stripe__Plans__Enterprise__MonthlyPriceId=
Stripe__Plans__Enterprise__YearlyPriceId=

# --- Reports scheduler ---
Reports__Scheduler__Enabled=true
Reports__Scheduler__PollSeconds=60
Reports__Scheduler__MaxSchedulesPerCycle=20
Reports__Scheduler__DefaultReportType=impact-summary
Reports__Scheduler__DefaultFormat=pdf
