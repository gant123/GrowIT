@page "/clients/{Id:guid}"
@using GrowIT.Shared.DTOs
@using GrowIT.Client.Shared 
@inject IClientService ClientService
@inject NavigationManager Nav
@inject BreadcrumbState Breadcrumb
@inject AppNotificationService Notifications

<PageTitle>@(client?.FullName ?? "Profile") - grow.IT</PageTitle>

@if (_isLoading)
{
    <div class="loading-state">
        <div class="spinner-growit"></div>
        <p class="loading-state-text">Loading profile...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center mb-4">
        <span>@_loadError</span>
        <button class="btn btn-sm btn-outline-light" @onclick="ReloadProfile">Retry</button>
    </div>
}
else
{
    <div class="client-profile-page fade-in">
    <PageHeader Title="@client!.FullName" Subtitle="Household service record, financial visibility, and documented growth timeline.">
        <Actions>
            <a href="/clients" class="btn-growit btn-secondary-growit">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <button class="btn-growit btn-secondary-growit" @onclick="OpenEditModal">
                <i class="bi bi-pencil-square me-1"></i> Edit
            </button>
            <button class="btn-growit btn-secondary-growit client-delete-btn" @onclick="OpenDeleteDialog">
                <i class="bi bi-trash me-1" aria-hidden="true"></i> Delete
            </button>
            <button class="btn-growit btn-primary-growit" @onclick="OpenAddMemberModal">
                <i class="bi bi-person-plus me-2"></i>Add Household Member
            </button>
        </Actions>
    </PageHeader>

    <div class="grid-4 mb-4">
        <div class="client-profile-metric">
            <div class="metric-icon success"><i class="bi bi-cash-stack"></i></div>
            <div class="metric-content">
                <div class="metric-label">Verified Service Value</div>
                <div class="metric-value">@client.TotalInvestment.ToString("C0")</div>
                <div class="metric-subtext">Total documented service records</div>
            </div>
        </div>
        <div class="client-profile-metric">
            <div class="metric-icon info"><i class="bi bi-calendar-event"></i></div>
            <div class="metric-content">
                <div class="metric-label">Last Service Record</div>
                <div class="metric-value-sm">@(client.LastInvestmentDate?.ToString("MMM dd, yyyy") ?? "No record")</div>
                <div class="metric-subtext">Most recent support provided</div>
            </div>
        </div>
        <div class="client-profile-metric">
            <div class="metric-icon warning"><i class="bi bi-people"></i></div>
            <div class="metric-content">
                <div class="metric-label">Household Members</div>
                <div class="metric-value">@client.HouseholdMembers.Count</div>
                <div class="metric-subtext">Family members on this profile</div>
            </div>
        </div>
        <div class="client-profile-metric">
            <div class="metric-icon primary"><i class="bi bi-diagram-3"></i></div>
            <div class="metric-content">
                <div class="metric-label">Readiness Signal</div>
                <div class="metric-value-sm">@GetReadinessLabel()</div>
                <div class="metric-subtext">@GetReadinessHint()</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
            <div class="col-lg-4">
                <div class="card-growit mb-4">
                    <div class="card-header">
                        <h3 class="section-title">Financial Visibility</h3>
                    </div>
                    <div class="card-body">
                        <div class="profile-hero-value">
                            <div class="hero-value-number text-success">@client.TotalInvestment.ToString("C0")</div>
                            <div class="hero-value-label">Lifetime documented service value</div>
                        </div>
                        <div class="detail-list">
                            <div class="detail-row">
                                <span>Current stage</span>
                                <span class="badge-growit @GetPhaseBadgeClass(client.LifePhase)">@client.LifePhase</span>
                            </div>
                            @* Contact details and household size are collected on the form but were
                               never shown here. *@
                            <div class="detail-row">
                                <span>Phone</span>
                                <strong>@(string.IsNullOrWhiteSpace(client.Phone) ? "Not set" : client.Phone)</strong>
                            </div>
                            <div class="detail-row">
                                <span>Email</span>
                                <strong class="text-break">@(string.IsNullOrWhiteSpace(client.Email) ? "Not set" : client.Email)</strong>
                            </div>
                            <div class="detail-row">
                                <span>People in household</span>
                                <strong>@client.HouseholdCount</strong>
                            </div>
                            <div class="detail-row">
                                <span>Employment</span>
                                <strong>@client.EmploymentStatus</strong>
                            </div>
                            <div class="detail-row">
                                <span>Marital status</span>
                                <strong>@client.MaritalStatus</strong>
                            </div>
                            <div class="detail-row">
                                <span>Stability score</span>
                                <strong>@client.StabilityScore / 10</strong>
                            </div>
                            @* Which household (Households page) this person is grouped into. The "Household"
                               card below lists the family members recorded on this profile. *@
                            <div class="detail-row">
                                <span>Household</span>
                                @if (client.HouseholdId.HasValue && !string.IsNullOrWhiteSpace(client.HouseholdName))
                                {
                                    <strong><a href="/households" class="profile-household-link">@client.HouseholdName</a> · @FormatRole(client.HouseholdRole)</strong>
                                }
                                else
                                {
                                    <strong>Not in a household</strong>
                                }
                            </div>
                            <div class="detail-row">
                                <span>Date of birth</span>
                                <strong>@(client.DateOfBirth?.ToString("MMM dd, yyyy") ?? "Not set")</strong>
                            </div>
                            <div class="detail-row">
                                <span>SSN last 4</span>
                                <strong>@(string.IsNullOrWhiteSpace(client.MaskedSSNLast4) ? "Not set" : client.MaskedSSNLast4)</strong>
                            </div>
                            <div class="detail-row">
                                <span>Next follow-up</span>
                                @if (client.NextFollowupDate.HasValue)
                                {
                                    @* Setting this date adds a check-in to Follow-ups. *@
                                    <strong><a href="/tasks" class="profile-household-link" title="Open Follow-ups">@client.NextFollowupDate.Value.ToString("MMM dd, yyyy")</a></strong>
                                }
                                else
                                {
                                    <strong>Not set</strong>
                                }
                            </div>
                            <div class="detail-row">
                                <span>Address</span>
                                <strong>@(string.IsNullOrWhiteSpace(client.Address) ? "Not set" : client.Address)</strong>
                            </div>
                            <div class="detail-row">
                                <span>Last service record</span>
                                <strong>@(client.LastInvestmentDate?.ToString("MMM dd, yyyy") ?? "Never")</strong>
                            </div>
                            <div class="detail-row">
                                <span>Service records</span>
                                <strong>@client.Timeline.Count(t => t.Type == "Investment")</strong>
                            </div>
                            <div class="detail-row">
                                <span>Outcomes recorded</span>
                                <strong>@client.Timeline.Count(t => t.Type != "Investment")</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-growit">
                    <div class="card-header">
                        <h3 class="section-title">Household (@client.HouseholdMembers.Count)</h3>
                        <button class="btn-growit btn-ghost-growit btn-sm" @onclick="OpenAddMemberModal">
                            <i class="bi bi-plus-lg me-1"></i>Add Member
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <p class="household-explainer">
                            Family members recorded on this profile. To group people who each have their own profile, use <a href="/households">Households</a>.
                        </p>
                        @if (client.HouseholdMembers.Any())
                        {
                            <ul class="list-group list-group-flush household-list">
                                @foreach (var member in client.HouseholdMembers)
                                {
                                    <li class="list-group-item px-3 py-3 household-list-item" @onclick="() => NavigateToMember(member.Id)">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="household-avatar">
                                                    <i class="@GetRelationshipIconClass(member.Relationship)"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-sm">@member.Name</div>
                                                    <div class="small text-secondary household-meta">
                                                        @member.Relationship • @member.Age yrs
                                                    </div>
                                                    <div class="small text-secondary household-meta">
                                                        Need @member.RequestedNeed.ToString("C0") • Funded @member.FundedAmount.ToString("C0") • Remaining @member.RemainingNeed.ToString("C0")
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge-growit @(member.RemainingNeed > 0 ? "badge-warning" : "badge-success") household-tag">
                                                    @member.RemainingNeed.ToString("C0") gap
                                                </span>
                                                @if (member.LastSupportDate.HasValue)
                                                {
                                                    <div class="small text-secondary mt-1">@member.LastSupportDate.Value.ToString("MMM dd")</div>
                                                }
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(member.School))
                                        {
                                            <div class="small text-secondary mt-2">@member.School</div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="bi bi-people empty-state-icon"></i>
                                <div class="empty-state-title">No household members listed</div>
                                <div class="empty-state-description">Add household members to track service and outcomes for each person.</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card-growit h-100">
                    <div class="card-header">
                        <h3 class="section-title">Service Timeline</h3>
                        <span class="badge-growit badge-neutral">@client.Timeline.Count Entries</span>
                    </div>
                    <div class="card-body p-0">
                        @if (client.Timeline.Any())
                        {
                            <div class="list-group list-group-flush timeline-list">
                                @foreach (var item in client.Timeline)
                                {
                                    <div class="list-group-item d-flex gap-3 timeline-item">
                                        <div class="d-flex flex-column align-items-center timeline-rail">
                                            <div class="timeline-dot @MapTimelineTone(item.ColorClass)">
                                                <i class="@MapTimelineIcon(item.Icon)"></i>
                                            </div>
                                            <div class="timeline-line"></div>
                                        </div>

                                        <div class="flex-grow-1 timeline-content">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <h6 class="fw-bold mb-1">@item.Title</h6>
                                                <div>
                                                    <small class="text-muted">@item.Date.ToString("MMM dd, yyyy")</small>
                                                    @if (item.Type == "Investment")
                                                    {
                                                        <button type="button" class="btn btn-sm btn-link text-info p-0 ms-2" title="Move this service record to another family member"
                                                                aria-label="Move this service record to another family member" @onclick="() => OpenReassignModal(item.Id)">
                                                            <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            <p class="mb-1 text-secondary small">@item.Description</p>
                                            
                                            @if (item.Amount.HasValue && item.Amount > 0)
                                            {
                                                <div class="mt-2">
                                                    <span class="badge-growit bg-success text-white">
                                                        @item.Amount.Value.ToString("C2")
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="bi bi-journal-text empty-state-icon"></i>
                                <div class="empty-state-title">No service timeline yet</div>
                                <div class="empty-state-description">Service records and outcomes will appear here as work is documented.</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

        <AddClientModal @bind-Show="showEditModal"
                        EditClientId="@Id"
                        EditValues="_editValues"
                        HasSsnOnFile="@(!string.IsNullOrWhiteSpace(client.MaskedSSNLast4))"
                        OnClientAdded="ReloadProfile" />

        <AddFamilyMemberModal @bind-Show="showAddMemberModal" 
                              ClientId="@Id" 
                              DefaultLastName="@(client.LastName)"
                              OnMemberAdded="ReloadProfile" />

        <ReassignInvestmentModal @bind-Show="showReassignModal" 
                                 InvestmentId="selectedInvestmentId"
                                 Members="client.HouseholdMembers"
                                 OnChanged="ReloadProfile" />

        <ConfirmActionModal @bind-Show="_showDeleteDialog"
                            Title="@($"Delete {client.FullName}?")"
                            ConfirmText="Delete person"
                            IsBusy="_isDeleting"
                            ConfirmDisabled="_deleteBlocked"
                            ErrorMessage="@_deleteMessage"
                            OnConfirm="DeleteClientAsync">
            <p class="mb-2">This permanently removes <strong>@client.FullName</strong> from People. It can't be undone.</p>
            <ul class="small text-secondary mb-0 ps-3">
                @if (client.HouseholdMembers.Count > 0)
                {
                    <li>The @client.HouseholdMembers.Count family member(s) recorded on this profile are removed too.</li>
                }
                @if (client.HouseholdId.HasValue)
                {
                    <li>They are taken out of @(client.HouseholdName ?? "their household"); the household and its other people stay.</li>
                }
                <li>Their follow-ups are removed.</li>
                <li>People with service records, outcomes, growth plans or documents can't be deleted, so that history is never lost.</li>
            </ul>
        </ConfirmActionModal>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ClientDetailDto? client;
    private bool showAddMemberModal = false;
    private bool showReassignModal = false;
    private Guid selectedInvestmentId;
    private bool _isLoading = true;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        await ReloadProfile();
    }

    private async Task ReloadProfile()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            client = await ClientService.GetClientDetailAsync(Id);
            if (client is not null)
            {
                Breadcrumb.Set($"/clients/{Id}", client.FullName);
            }
        }
        catch (Exception ex)
        {
            client = null;
            _loadError = ex.Message;
            Console.WriteLine($"Error loading profile: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateToMember(Guid memberId)
    {
        Nav.NavigateTo($"/clients/member/{memberId}");
    }

    private void OpenAddMemberModal() => showAddMemberModal = true;

    private bool _showDeleteDialog;
    private bool _isDeleting;
    private bool _deleteBlocked;
    private string? _deleteMessage;

    private void OpenDeleteDialog()
    {
        if (client is null) return;

        // Service records and outcomes are already on this page, so say up front when the
        // delete will be refused; growth plans and documents are checked by the server.
        var serviceRecords = client.Timeline.Count(t => t.Type == "Investment");
        var outcomes = client.Timeline.Count(t => t.Type != "Investment");
        _deleteBlocked = serviceRecords + outcomes > 0;
        _deleteMessage = _deleteBlocked
            ? $"{client.FullName} can't be deleted because {DescribeCounts(serviceRecords, outcomes)} linked to their profile. Delete or move those records first, or keep this profile."
            : null;
        _showDeleteDialog = true;
    }

    private async Task DeleteClientAsync()
    {
        if (client is null || _isDeleting) return;

        _isDeleting = true;
        try
        {
            var outcome = await ClientService.DeleteClientAsync(Id);
            if (outcome.Succeeded)
            {
                Notifications.Success(outcome.Message);
                _showDeleteDialog = false;
                Nav.NavigateTo("/clients");
                return;
            }

            _deleteBlocked = true;
            _deleteMessage = outcome.Message;
        }
        catch (Exception ex)
        {
            // The service already showed an error toast; keep the reason in the dialog too.
            _deleteMessage = ex is ApiException ? ex.Message : "We couldn't delete this person. Please try again.";
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private static string DescribeCounts(int serviceRecords, int outcomes)
    {
        var parts = new List<string>();
        if (serviceRecords > 0) parts.Add(serviceRecords == 1 ? "1 service record" : $"{serviceRecords} service records");
        if (outcomes > 0) parts.Add(outcomes == 1 ? "1 outcome" : $"{outcomes} outcomes");
        var verb = serviceRecords + outcomes == 1 ? "is" : "are";
        return $"{string.Join(" and ", parts)} {verb}";
    }

    private static string FormatRole(GrowIT.Shared.Enums.HouseholdRole role) => role switch
    {
        GrowIT.Shared.Enums.HouseholdRole.Head => "Head of household",
        GrowIT.Shared.Enums.HouseholdRole.Spouse => "Spouse",
        GrowIT.Shared.Enums.HouseholdRole.Dependent => "Dependent",
        _ => "Other"
    };

    private bool showEditModal;
    private CreateClientRequest? _editValues;

    private void OpenEditModal()
    {
        if (client is null) return;

        // Carry every saved value across (including household link and photo), because the
        // update endpoint replaces the whole profile with what the form sends.
        _editValues = new CreateClientRequest
        {
            FirstName = client.FirstName,
            LastName = client.LastName,
            Email = string.IsNullOrWhiteSpace(client.Email) ? null : client.Email,
            Phone = string.IsNullOrWhiteSpace(client.Phone) ? null : client.Phone,
            Address = client.Address,
            DateOfBirth = client.DateOfBirth,
            PhotoUrl = client.PhotoUrl,
            MaritalStatus = client.MaritalStatus,
            EmploymentStatus = client.EmploymentStatus,
            HouseholdCount = client.HouseholdCount,
            StabilityScore = client.StabilityScore,
            LifePhase = client.LifePhase,
            HouseholdId = client.HouseholdId,
            HouseholdRole = client.HouseholdRole,
            NextFollowupDate = client.NextFollowupDate
        };
        showEditModal = true;
    }

    private void OpenReassignModal(Guid investmentId)
    {
        selectedInvestmentId = investmentId;
        showReassignModal = true;
    }

    private string GetRelationshipIconClass(string relationship)
    {
        var rel = relationship?.ToLower() ?? "";
        if (rel.Contains("spouse") || rel.Contains("wife") || rel.Contains("husband")) return "bi bi-heart";
        if (rel.Contains("child") || rel.Contains("son") || rel.Contains("daughter")) return "bi bi-balloon-heart";
        if (rel.Contains("pet") || rel.Contains("dog") || rel.Contains("cat")) return "bi bi-stars";
        if (rel.Contains("parent") || rel.Contains("mother") || rel.Contains("father")) return "bi bi-person-hearts";
        return "bi bi-person";
    }

    private string GetReadinessLabel()
    {
        if (client is null) return "N/A";
        if (client.StabilityScore >= 8 && client.LifePhase == GrowIT.Shared.Enums.LifePhase.Thriving) return "Funding-ready";
        if (client.StabilityScore >= 5) return "Building";
        return "Stabilize";
    }

    private string GetReadinessHint()
    {
        if (client is null) return "No data";
        if (client.LifePhase == GrowIT.Shared.Enums.LifePhase.Crisis) return "Prioritize support and rapid follow-up";
        if (client.LifePhase == GrowIT.Shared.Enums.LifePhase.Stable) return "Track repeatable progress and needs";
        return "Document outcomes and long-term gains";
    }

    private string GetPhaseBadgeClass(GrowIT.Shared.Enums.LifePhase phase) => phase switch
    {
        GrowIT.Shared.Enums.LifePhase.Crisis => "badge-phase-crisis",
        GrowIT.Shared.Enums.LifePhase.Stable => "badge-phase-stable",
        GrowIT.Shared.Enums.LifePhase.Thriving => "badge-phase-thriving",
        _ => "badge-neutral"
    };

    private static string MapTimelineIcon(string icon) => icon switch
    {
        var value when value.Contains("dollar", StringComparison.OrdinalIgnoreCase) => "bi bi-cash-stack",
        var value when value.Contains("flag", StringComparison.OrdinalIgnoreCase) => "bi bi-flag",
        var value when value.Contains("check", StringComparison.OrdinalIgnoreCase) => "bi bi-check2-circle",
        var value when value.Contains("people", StringComparison.OrdinalIgnoreCase) || value.Contains("person", StringComparison.OrdinalIgnoreCase) => "bi bi-people",
        _ => "bi bi-activity"
    };

    private static string MapTimelineTone(string colorClass) => colorClass switch
    {
        var value when value.Contains("success", StringComparison.OrdinalIgnoreCase) => "success",
        var value when value.Contains("warning", StringComparison.OrdinalIgnoreCase) => "warning",
        var value when value.Contains("danger", StringComparison.OrdinalIgnoreCase) => "danger",
        var value when value.Contains("info", StringComparison.OrdinalIgnoreCase) => "info",
        _ => "neutral"
    };
}
