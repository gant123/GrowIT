@page "/clients/create"
@inject NavigationManager Nav

@* There used to be a second, different add-person form here ("Create Founder Case File", other
   fields and wording). Adding a person now always uses the one form: the Add Person dialog on
   People. Old links and bookmarks to /clients/create open that dialog. *@

<PageTitle>Add person - grow.IT</PageTitle>

@code {
    protected override void OnInitialized()
    {
        Nav.NavigateTo("/clients?new=1", replace: true);
    }
}
