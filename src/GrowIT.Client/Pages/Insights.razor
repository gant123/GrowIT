@page "/insights"
@using GrowIT.Shared.DTOs
@using GrowIT.Client.Services
@using Syncfusion.Blazor.Charts
@inject IInsightsService InsightsService
@inject IRoleAccessService RoleAccessService
@inject IJSRuntime JS

<PageTitle>Insights - grow.IT</PageTitle>

<div class="insights-container fade-in" style="max-width: 1200px; margin: 0 auto; padding: 20px;">
    <PageHeader Title="Operational Insights" Subtitle="Data-driven intelligence to protect the mission and prove impact." />

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 400px;">
            <div class="spinner-growit"></div>
        </div>
    }
    else if (!_hasAccess)
    {
        <div class="alert alert-warning" role="alert">Insights are available to Admin, Manager, or Owner roles.</div>
    }
    else if (_insights == null)
    {
        <div class="alert alert-warning">Failed to load insights. Please try again later.</div>
    }
    else
    {
        <div class="grid-2 mb-4">
            <!-- Money runway card. The funding-readiness score lives on the ASC Score page; this
                 card used to show a second, contradictory score computed from almost no data. -->
            <div class="card-growit">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="section-title mb-0">Money Runway</h3>
                    <a class="small" href="/organization">Funding readiness score <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="card-body">
                    <div class="runway-stats mb-4">
                        <div>
                            <div class="text-muted small text-uppercase fw-700">Available now</div>
                            <div class="display-6 fw-700">@_insights.FundingReadiness.AvailableFunds.ToString("C0", UsCulture)</div>
                            <div class="text-muted small">across your money sources</div>
                        </div>
                        <div>
                            <div class="text-muted small text-uppercase fw-700">Estimated runway</div>
                            @if (_insights.FundingReadiness.HasSpendingHistory)
                            {
                                <div class="display-6 fw-700">@_insights.FundingReadiness.EstimatedRunwayMonths @(_insights.FundingReadiness.EstimatedRunwayMonths == 1 ? "month" : "months")</div>
                                <div class="text-muted small">at @_insights.FundingReadiness.BurnRateMonthly.ToString("C0", UsCulture) a month (last 90 days)</div>
                            }
                            else
                            {
                                <div class="display-6 fw-700 text-muted">Not yet</div>
                                <div class="text-muted small">needs a few weeks of paid-out services</div>
                            }
                        </div>
                    </div>

                    <div class="recommendations">
                        <div class="fw-600 mb-2 small text-uppercase" style="letter-spacing: 0.05em;">Recommendations</div>
                        @foreach (var suggestion in _insights.FundingReadiness.Suggestions)
                        {
                            <div class="d-flex mb-2">
                                <i class="bi bi-lightbulb text-warning me-2"></i>
                                <span class="small">@suggestion</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Impact Velocity Card -->
            <div class="card-growit">
                <div class="card-header">
                    <h3 class="section-title mb-0">Outcomes Pace</h3>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-end mb-2">
                            <div>
                                <div class="text-muted small text-uppercase fw-700">Outcomes (last 30 days)</div>
                                <div class="display-6 fw-700">@_insights.ImpactVelocity.CurrentVelocity</div>
                            </div>
                            <div class="text-end">
                                <div class="fw-700 @(_insights.ImpactVelocity.GrowthPercentage >= 0 ? "text-success" : "text-danger")">
                                    <i class="bi @(_insights.ImpactVelocity.GrowthPercentage >= 0 ? "bi-arrow-up" : "bi-arrow-down")"></i>
                                    @Math.Abs(_insights.ImpactVelocity.GrowthPercentage).ToString("F1")%
                                </div>
                                <div class="text-muted small">vs previous period</div>
                            </div>
                        </div>
                        <div class="velocity-track">
                             <div class="velocity-bar" style="width: @(GetVelocityWidth() + "%");"></div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <h4 class="small fw-700 text-uppercase mb-3">Most common outcome types</h4>
                        @foreach (var program in _insights.ProgramPerformance)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small">@program.Name</span>
                                <div class="d-flex align-items-center">
                                    <span class="fw-600 me-2">@program.Count</span>
                                    <div class="impact-track">
                                        @{ var progWidth = GetProgramWidth(program.Count) + "%"; }
                                        <div class="impact-bar" style="width: @progWidth;"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card-growit">
            <div class="card-header">
                <h3 class="section-title mb-0">Spending by Program</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        @if (_insights.AllocationInsights.Count == 0)
                        {
                            <div class="text-muted small py-5 text-center">No paid-out services yet.</div>
                        }
                        else
                        {
                        <SfAccumulationChart Background="transparent" Theme="@_chartTheme" Height="300px">
                            <AccumulationChartSeriesCollection>
                                <AccumulationChartSeries DataSource="@_insights.AllocationInsights"
                                                          XName="Category" YName="Amount" Name="Program"
                                                          InnerRadius="40%" Palettes="@AllocationPalette">
                                    <AccumulationDataLabelSettings Visible="true" Name="Category" Position="AccumulationLabelPosition.Outside">
                                        <AccumulationChartConnector Type="ConnectorType.Line" Length="10%"></AccumulationChartConnector>
                                        <AccumulationChartDataLabelFont FontFamily="@ChartFont" Size="12px"></AccumulationChartDataLabelFont>
                                    </AccumulationDataLabelSettings>
                                </AccumulationChartSeries>
                            </AccumulationChartSeriesCollection>
                            <AccumulationChartLegendSettings Visible="false"></AccumulationChartLegendSettings>
                            <AccumulationChartTooltipSettings Enable="true" Format="${point.x}: <b>$${point.y}</b>"></AccumulationChartTooltipSettings>
                        </SfAccumulationChart>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless theme-aware-table">
                                <thead class="text-muted small text-uppercase">
                                    <tr>
                                        <th>Program</th>
                                        <th class="text-end">Amount</th>
                                        <th class="text-end">Share</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var index = 0; index < _insights.AllocationInsights.Count; index++)
                                    {
                                        var item = _insights.AllocationInsights[index];
                                        <tr>
                                            <td class="py-2">
                                                <div class="d-flex align-items-center">
                                                    @* Same color as this program's slice in the chart. *@
                                                    <div class="category-dot" style="background: @AllocationPalette[index % AllocationPalette.Length]"></div>
                                                    @item.Category
                                                </div>
                                            </td>
                                            <td class="text-end py-2 fw-600">@item.Amount.ToString("C0", UsCulture)</td>
                                            <td class="text-end py-2 text-muted">@item.Percentage.ToString("F1")%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .insights-container {
        animation: fadeIn 0.5s ease-in-out;
    }
    .recommendations {
        background: var(--growit-bg-secondary);
        padding: 15px;
        border-radius: 8px;
        border: 1px dashed var(--growit-border);
    }
    .display-6 {
        font-size: 1.75rem;
        letter-spacing: -0.02em;
        color: var(--growit-text-primary);
    }
    .runway-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 16px;
    }
    .velocity-track, .impact-track {
        height: 10px; 
        background: var(--growit-border-light); 
        border-radius: 5px; 
        overflow: hidden;
    }
    .velocity-bar {
        height: 100%; 
        background: var(--growit-green); 
        transition: width 1s ease-in-out;
    }
    .impact-track {
        width: 100px; 
        height: 6px;
    }
    .impact-bar {
        height: 100%; 
        background: var(--growit-primary); 
        border-radius: 3px;
    }
    .category-dot {
        width: 10px; 
        height: 10px; 
        border-radius: 50%; 
        background: var(--growit-green); 
        margin-right: 8px;
    }
    .theme-aware-table {
        color: var(--growit-text-primary);
    }

    [data-theme="dark"] .recommendations {
        background: rgba(255, 255, 255, 0.03);
    }
</style>

@code {
    private InsightsDto? _insights;
    private bool _isLoading = true;
    private bool _isDarkMode = false;
    private Theme _chartTheme = Theme.Bootstrap5;

    private bool _hasAccess = true;

    // One palette for the chart slices and the table dots so they match.
    private static readonly string[] AllocationPalette =
        ["#27B062", "#32505A", "#F59E0B", "#3B82F6", "#A855F7", "#EF4444", "#14B8A6", "#64748B"];
    private const string ChartFont = "Inter, 'Segoe UI', system-ui, sans-serif";
    // Amounts are dollars; don't depend on the server's culture (that printed "¤" in reports).
    private static readonly System.Globalization.CultureInfo UsCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Same audience as Reports and the Insights menu item.
            var access = await RoleAccessService.GetAccessAsync();
            _hasAccess = access.CanAccessReports;
            if (_hasAccess)
            {
                _insights = await InsightsService.GetInsightsAsync();
            }
        }
        catch
        {
            _insights = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Use the theme manager (localStorage key 'growit-theme'), not a raw
                // localStorage read with the wrong key — that left charts stuck in light.
                var theme = await JS.InvokeAsync<string>("blazorInterop.getTheme");
                _isDarkMode = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
                _chartTheme = _isDarkMode ? Theme.Bootstrap5Dark : Theme.Bootstrap5;
                StateHasChanged();
            }
            catch
            {
                // Fallback to light
            }
        }
    }

    private double GetVelocityWidth()
    {
        if (_insights == null || _insights.ImpactVelocity.CurrentVelocity == 0) return 0;
        var max = Math.Max(_insights.ImpactVelocity.CurrentVelocity, _insights.ImpactVelocity.PreviousVelocity);
        if (max == 0) return 0;
        return (double)_insights.ImpactVelocity.CurrentVelocity / max * 100;
    }

    private double GetProgramWidth(int count)
    {
        if (_insights == null || !_insights.ProgramPerformance.Any()) return 0;
        var max = _insights.ProgramPerformance.Max(p => p.Count);
        if (max == 0) return 0;
        return (double)count / max * 100;
    }
}
