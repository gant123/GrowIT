@page "/not-found"
@layout PublicLayout

<PageTitle>Page Not Found - grow.IT</PageTitle>

<div class="access-denied-page">
    <div class="access-denied-card">
        <span class="access-denied-kicker">Error 404</span>
        <h1>We couldn't find that page.</h1>
        <p>
            The link may be out of date, or the address may have a typo.
            Nothing is wrong with your account or your saved information.
        </p>

        <div class="access-denied-actions">
            <AuthorizeView>
                <Authorized>
                    <a href="/home" class="btn btn-primary">Back to your workspace</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/welcome" class="btn btn-primary">Go to the home page</a>
                    <a href="/login" class="btn btn-outline">Sign In</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>
