@page "/tasks"
@using GrowIT.Shared.DTOs
@using GrowIT.Shared.Enums
@inject ITaskService TaskService
@inject IClientService ClientService
@inject NavigationManager Nav
@inject AppNotificationService Notifications

<PageTitle>Follow-ups - grow.IT</PageTitle>

<div class="dashboard fade-in mt-4">
    <PageHeader Title="Follow-ups" Subtitle="Action items that show who owns the next step and when it is due.">
        <Actions>
            <button class="btn-growit btn-secondary-growit" @onclick="LoadData" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
            <button class="btn-growit btn-primary-growit" @onclick="OpenCreate">
                <i class="bi bi-plus-lg me-1"></i>New Follow-up
            </button>
        </Actions>
    </PageHeader>

    @if (_isLoading)
    {
        <div class="loading-state">
            <div class="spinner-growit"></div>
            <p class="loading-state-text">Loading follow-ups...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="grid-4 mb-4">
            <KpiCard Label="Pending" Value="@PendingCount.ToString()" Icon="bi bi-list-check" Color="warning" TrendText="Open follow-ups" />
            <KpiCard Label="Overdue" Value="@OverdueCount.ToString()" Icon="bi bi-exclamation-triangle" Color="danger" TrendText="Past due" />
            <KpiCard Label="Completed" Value="@CompletedCount.ToString()" Icon="bi bi-check2-circle" Color="success" TrendText="Closed work" />
            <KpiCard Label="Skipped" Value="@SkippedCount.ToString()" Icon="bi bi-skip-forward" Color="info" TrendText="Not pursued" />
        </div>

        <div class="card-growit mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-3 align-items-end">
                    <div style="min-width: 220px;">
                        <label class="form-label" for="followup-status-filter">Status</label>
                        <InputSelect id="followup-status-filter" @bind-Value="_statusFilter" class="form-select">
                            <option value="">Pending only</option>
                            <option value="All">All</option>
                            <option value="@GrowIT.Shared.Enums.TaskStatus.Completed">Completed</option>
                            <option value="@GrowIT.Shared.Enums.TaskStatus.Skipped">Skipped</option>
                        </InputSelect>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-growit">
            <div class="card-header">
                <h3 class="section-title">Follow-up Queue</h3>
                <span class="badge-growit badge-neutral">@_tasks.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!_tasks.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-check2-circle empty-state-icon text-success"></i>
                        <div class="empty-state-title">@(_allTasks.Any() ? "Nothing in this view" : "No follow-ups yet")</div>
                        <p class="empty-state-description">
                            @(_allTasks.Any()
                                ? "No follow-ups match this status. Choose another status above to see the rest."
                                : "Add one with New Follow-up, or set a Next follow-up date on a person's profile and it shows up here as a check-in.")
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle followup-table">
                            <thead>
                                <tr>
                                    <th>Person</th>
                                    <th>Follow-up</th>
                                    <th>Type</th>
                                    <th>Assignee</th>
                                    <th>Due</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in _tasks)
                                {
                                    <tr @key="task.Id">
                                        <td>
                                            <a class="person-link" href="@($"/clients/{task.ClientId}")">@task.ClientName</a>
                                        </td>
                                        <td>
                                            <div>@task.Notes</div>
                                            @if (task.IsFromNextFollowUpDate)
                                            {
                                                <span class="followup-source" title="Created from the Next follow-up date on this person's profile">
                                                    <i class="bi bi-person-lines-fill" aria-hidden="true"></i> From profile date
                                                </span>
                                            }
                                        </td>
                                        <td>@FormatActionItemType(task.Type)</td>
                                        <td>@task.AssignedToName</td>
                                        <td>
                                            <span class="@(task.IsOverdue ? "text-danger fw-bold" : "")">@task.DueDate.ToString("MMM dd, yyyy")</span>
                                            @if (task.IsOverdue)
                                            {
                                                <span class="visually-hidden">(overdue)</span>
                                            }
                                        </td>
                                        <td><span class="badge-growit @GetStatusBadge(task.Status)">@task.Status</span></td>
                                        <td class="text-end">
                                            <div class="followup-actions">
                                                <button type="button" class="btn-icon-only"
                                                        aria-label="@($"Edit follow-up for {task.ClientName}")" title="Edit"
                                                        disabled="@(_busyTaskId == task.Id)"
                                                        @onclick="() => OpenEdit(task)">
                                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                                </button>
                                                @if (task.Status == GrowIT.Shared.Enums.TaskStatus.Pending)
                                                {
                                                    <button type="button" class="btn-icon-only success"
                                                            aria-label="@($"Mark follow-up for {task.ClientName} complete")" title="Mark complete"
                                                            disabled="@(_busyTaskId == task.Id)"
                                                            @onclick="() => ChangeStatus(task, GrowIT.Shared.Enums.TaskStatus.Completed)">
                                                        <i class="bi bi-check2" aria-hidden="true"></i>
                                                    </button>
                                                    <button type="button" class="btn-icon-only"
                                                            aria-label="@($"Skip follow-up for {task.ClientName}")" title="Skip"
                                                            disabled="@(_busyTaskId == task.Id)"
                                                            @onclick="() => ChangeStatus(task, GrowIT.Shared.Enums.TaskStatus.Skipped)">
                                                        <i class="bi bi-skip-forward" aria-hidden="true"></i>
                                                    </button>
                                                }
                                                <button type="button" class="btn-icon-only danger"
                                                        aria-label="@($"Delete follow-up for {task.ClientName}")" title="Delete"
                                                        disabled="@(_busyTaskId == task.Id)"
                                                        @onclick="() => OpenDelete(task)">
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (_showForm)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.65); z-index: 1200;" tabindex="-1"
         role="dialog" aria-modal="true" aria-labelledby="followup-form-title">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title" id="followup-form-title">@(IsEditing ? "Edit Follow-up" : "New Follow-up")</h5>
                    <button type="button" class="btn-close" aria-label="Close" title="Close" @onclick="CloseForm" disabled="@_isSaving"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(_modalError))
                    {
                        <div class="alert alert-danger" role="alert">@_modalError</div>
                    }
                    @if (IsEditing && _editingFromProfileDate)
                    {
                        <div class="alert alert-info small py-2" role="note">
                            This check-in comes from the person's Next follow-up date. Changing the due date here doesn't change the date on their profile.
                        </div>
                    }
                    <EditForm Model="@_form" OnValidSubmit="SaveForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger small mb-2" />
                        <div class="mb-3">
                            <label class="form-label" for="followup-person">Person <span class="text-danger" aria-hidden="true">*</span></label>
                            <InputSelect id="followup-person" @bind-Value="_form.ClientId" class="form-select">
                                <option value="@Guid.Empty">Select a person</option>
                                @foreach (var client in _clients)
                                {
                                    <option value="@client.Id">@client.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="followup-assignee">Assignee <span class="text-danger" aria-hidden="true">*</span></label>
                            <InputSelect id="followup-assignee" @bind-Value="_form.AssignedTo" class="form-select">
                                <option value="@Guid.Empty">Select assignee</option>
                                @foreach (var user in _assignees.Where(u => u.IsActive || u.Id == _form.AssignedTo))
                                {
                                    <option value="@user.Id">@user.FullName</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="followup-type">Type</label>
                            <InputSelect id="followup-type" @bind-Value="_form.Type" class="form-select">
                                @foreach (var type in Enum.GetValues<ActionItemType>())
                                {
                                    <option value="@type">@FormatActionItemType(type)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="followup-due">Due date</label>
                            <InputDate id="followup-due" @bind-Value="_form.DueDate" class="form-control" />
                        </div>
                        @if (IsEditing)
                        {
                            <div class="mb-3">
                                <label class="form-label" for="followup-status">Status</label>
                                <InputSelect id="followup-status" @bind-Value="_form.Status" class="form-select">
                                    @foreach (var status in Enum.GetValues<GrowIT.Shared.Enums.TaskStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label" for="followup-notes">What needs to happen? <span class="text-danger" aria-hidden="true">*</span></label>
                            <InputTextArea id="followup-notes" @bind-Value="_form.Notes" class="form-control" rows="4" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn-growit btn-secondary-growit" @onclick="CloseForm" disabled="@_isSaving">Cancel</button>
                            <button type="submit" class="btn-growit btn-primary-growit" disabled="@_isSaving">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                <span>@(IsEditing ? "Save Changes" : "Save Follow-up")</span>
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmActionModal @bind-Show="_showDelete"
                    Title="Delete this follow-up?"
                    ConfirmText="Delete follow-up"
                    IsBusy="_isDeleting"
                    ErrorMessage="@_deleteError"
                    OnConfirm="DeleteTask">
    @if (_deleteTarget is not null)
    {
        <p class="mb-2"><strong>@_deleteTarget.Notes</strong></p>
        <p class="small text-secondary mb-0">For @_deleteTarget.ClientName, due @_deleteTarget.DueDate.ToString("MMM dd, yyyy"). This can't be undone; to keep a record, mark it complete or skipped instead.</p>
        @if (_deleteTarget.IsFromNextFollowUpDate)
        {
            <p class="small text-secondary mt-2 mb-0">It came from the Next follow-up date on @(_deleteTarget.ClientName)'s profile, so that date is cleared too.</p>
        }
    }
</ConfirmActionModal>

@code {
    // Everything loaded for the workspace; the cards count from this, the table shows the
    // filtered subset. Counting from the filtered list made "Completed" and "Skipped" read 0
    // under the default "Pending only" view, even right after completing a follow-up.
    private List<TaskListDto> _allTasks = [];

    private List<TaskListDto> _tasks => _statusFilter switch
    {
        "All" => _allTasks,
        _ when Enum.TryParse<GrowIT.Shared.Enums.TaskStatus>(_statusFilter, out var status) =>
            _allTasks.Where(t => t.Status == status).ToList(),
        _ => _allTasks.Where(t => t.Status == GrowIT.Shared.Enums.TaskStatus.Pending).ToList()
    };
    private List<ClientDto> _clients = [];
    private List<TaskAssigneeDto> _assignees = [];
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _showForm;
    private string? _error;
    private string? _modalError;
    private string? _statusFilter;

    // One form for New and Edit (the edit request also carries the status).
    private UpdateTaskRequest _form = new();
    private Guid? _editingId;
    private bool _editingFromProfileDate;
    private bool IsEditing => _editingId.HasValue;

    private Guid? _busyTaskId;
    private TaskListDto? _deleteTarget;
    private bool _showDelete;
    private bool _isDeleting;
    private string? _deleteError;

    private int PendingCount => _allTasks.Count(t => t.Status == GrowIT.Shared.Enums.TaskStatus.Pending);
    private int OverdueCount => _allTasks.Count(t => t.IsOverdue);
    private int CompletedCount => _allTasks.Count(t => t.Status == GrowIT.Shared.Enums.TaskStatus.Completed);
    private int SkippedCount => _allTasks.Count(t => t.Status == GrowIT.Shared.Enums.TaskStatus.Skipped);

    protected override async Task OnInitializedAsync() => await LoadData();

    // /tasks?new=1 opens the new follow-up form straight away (used by the "Log it" sheet).
    [SupplyParameterFromQuery(Name = "new")]
    public string? NewRequested { get; set; }

    private bool _openCreateWhenLoaded;

    protected override void OnParametersSet()
    {
        // Only once interactive: in the prerendered response a NavigateTo turns into an HTTP
        // redirect to /tasks, which lost the request to open the form on a direct visit.
        if (!string.IsNullOrEmpty(NewRequested) && RendererInfo.IsInteractive)
        {
            // The form's dropdowns need the loaded people/assignees; if they are still
            // loading (first visit), open as soon as LoadData finishes.
            if (_isLoading)
            {
                _openCreateWhenLoaded = true;
            }
            else
            {
                OpenCreate();
            }

            Nav.NavigateTo("/tasks", replace: true);
        }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _error = null;
        try
        {
            _clients = await ClientService.GetAllClientsAsync();
            _assignees = await TaskService.GetAssigneesAsync();
            await LoadTasks();

            if (_openCreateWhenLoaded)
            {
                _openCreateWhenLoaded = false;
                OpenCreate();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadTasks()
    {
        // The status dropdown filters this list in memory (see _tasks), so always load every status.
        _allTasks = await TaskService.GetTasksAsync(new TaskQueryParams { IncludeCompleted = true, PageSize = 100 });
    }

    private void OpenCreate()
    {
        _modalError = null;
        _editingId = null;
        _editingFromProfileDate = false;
        _form = new UpdateTaskRequest
        {
            DueDate = DateTime.UtcNow.Date.AddDays(7),
            ClientId = _clients.FirstOrDefault()?.Id ?? Guid.Empty,
            AssignedTo = _assignees.FirstOrDefault(u => u.IsActive)?.Id ?? Guid.Empty,
            Type = ActionItemType.ClientFollowUp,
            Status = GrowIT.Shared.Enums.TaskStatus.Pending
        };
        _showForm = true;
    }

    private void OpenEdit(TaskListDto task)
    {
        _modalError = null;
        _editingId = task.Id;
        _editingFromProfileDate = task.IsFromNextFollowUpDate;
        _form = new UpdateTaskRequest
        {
            ClientId = task.ClientId,
            AssignedTo = task.AssignedTo,
            Type = task.Type,
            DueDate = task.DueDate.Date,
            Notes = task.Notes,
            Status = task.Status
        };
        _showForm = true;
    }

    private void CloseForm()
    {
        if (_isSaving) return;
        _showForm = false;
    }

    private async Task SaveForm()
    {
        if (_isSaving) return;

        _modalError = null;
        _isSaving = true;
        try
        {
            if (_editingId is { } id)
            {
                await TaskService.UpdateTaskAsync(id, _form);
                Notifications.Success("Follow-up updated.");
            }
            else
            {
                await TaskService.CreateTaskAsync(_form);
                Notifications.Success("Follow-up added.");
            }

            _isSaving = false;
            _showForm = false;
            await LoadTasks();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ChangeStatus(TaskListDto task, GrowIT.Shared.Enums.TaskStatus status)
    {
        if (_busyTaskId.HasValue) return;

        _busyTaskId = task.Id;
        try
        {
            await TaskService.UpdateTaskStatusAsync(task.Id, status);
            Notifications.Success(status == GrowIT.Shared.Enums.TaskStatus.Completed
                ? $"Marked the follow-up for {task.ClientName} complete."
                : $"Skipped the follow-up for {task.ClientName}.");
            await LoadTasks();
        }
        catch (Exception)
        {
            // The service already showed the reason as a toast; keep the page working.
        }
        finally
        {
            _busyTaskId = null;
        }
    }

    private void OpenDelete(TaskListDto task)
    {
        _deleteTarget = task;
        _deleteError = null;
        _showDelete = true;
    }

    private async Task DeleteTask()
    {
        if (_deleteTarget is null || _isDeleting) return;

        _isDeleting = true;
        _deleteError = null;
        try
        {
            await TaskService.DeleteTaskAsync(_deleteTarget.Id);
            Notifications.Success("Follow-up deleted.");
            _isDeleting = false;
            _showDelete = false;
            _deleteTarget = null;
            await LoadTasks();
        }
        catch (Exception ex)
        {
            _deleteError = ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private static string GetStatusBadge(GrowIT.Shared.Enums.TaskStatus status) => status switch
    {
        GrowIT.Shared.Enums.TaskStatus.Completed => "badge-success",
        GrowIT.Shared.Enums.TaskStatus.Skipped => "badge-neutral",
        _ => "badge-warning"
    };

    private static string FormatActionItemType(ActionItemType type) => type switch
    {
        ActionItemType.ClientFollowUp => "Person follow-up",
        ActionItemType.BoardGovernance => "Board / governance",
        _ => type.ToString()
    };
}
