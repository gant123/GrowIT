<CascadingAuthenticationState>
    @* NotFoundPage renders Pages/NotFound.razor (public layout) for unknown URLs: both for
       in-app navigation and for the server-side re-execute configured in Program.cs. The old
       inline NotFound fragment drew the signed-in app shell, even for anonymous visitors. *@
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            @if (IsPublicRoute(routeData.PageType))
            {
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
            }
            else
            {
                <AuthorizeView Context="authContext">
                    <Authorized>
                        @* Outer gate requires authentication for all non-public pages; the inner
                           AuthorizeRouteView additionally enforces any [Authorize(Policy=...)]
                           a page declares (defense in depth on top of the API policies). *@
                        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                            <NotAuthorized>
                                <RedirectToLanding />
                            </NotAuthorized>
                        </AuthorizeRouteView>
                    </Authorized>
                    <NotAuthorized>
                        <RedirectToLanding />
                    </NotAuthorized>
                </AuthorizeView>
            }
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {
    private static readonly HashSet<string> PublicPages = new(StringComparer.Ordinal)
    {
        "Landing",
        "Blog",
        "BlogArticle",
        "Contact",
        "Changelog",
        "Docs",
        "Webinars",
        "Templates",
        "About",
        "Careers",
        "Partners",
        "Privacy",
        "Terms",
        "Security",
        "AccessDenied",
        "Login",
        "Register",
        "ForgotPassword",
        "ResetPassword",
        "AcceptInvite",
        "ConfirmEmail",
        "NotFound"
    };

    private static bool IsPublicRoute(Type pageType) => PublicPages.Contains(pageType.Name);
}
