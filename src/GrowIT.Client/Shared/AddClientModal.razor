@using GrowIT.Shared.DTOs
@using GrowIT.Shared.Enums 
@inject IClientService ClientService

@if (Show)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 1200;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg" style="background-color: var(--growit-bg-card); color: var(--growit-text-primary);">
                <div class="modal-header border-bottom" style="border-color: var(--growit-border);">
                    <h5 class="modal-title fw-bold">
                        <span class="oi @(IsEditMode ? "oi-pencil" : "oi-person") me-2 text-primary"></span>@(IsEditMode ? "Edit Profile" : "Add Person or Household")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-3 border-0" role="alert" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545;">
                            <span class="oi oi-warning me-2 fs-5"></span>
                            <div class="small fw-bold">@errorMessage</div>
                        </div>
                    }

                    <EditForm Model="@request" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        @* Without a summary, an invalid form (e.g. no name) made "Save Profile" do
                           nothing at all, with no hint why. *@
                        <ValidationSummary class="text-danger small mb-2" />

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted" for="add-client-first-name">First name <span class="text-danger" aria-hidden="true">*</span></label>
                            <InputText id="add-client-first-name" @bind-Value="request.FirstName" class="form-control" placeholder="e.g. Maria" style="@ThemeInputStyle" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted" for="add-client-last-name">Last name <span class="text-danger" aria-hidden="true">*</span></label>
                            <InputText id="add-client-last-name" @bind-Value="request.LastName" class="form-control" placeholder="e.g. Alvarez" style="@ThemeInputStyle" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Email</label>
                                <InputText @bind-Value="request.Email" class="form-control" placeholder="name@example.com" style="@ThemeInputStyle" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Phone</label>
                                <InputText @bind-Value="request.Phone" class="form-control" placeholder="(555) 123-4567" style="@ThemeInputStyle" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Address</label>
                            <InputText @bind-Value="request.Address" class="form-control" placeholder="Street, city, state, ZIP" style="@ThemeInputStyle" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-muted">Date of birth</label>
                                <InputDate @bind-Value="request.DateOfBirth" class="form-control" style="@ThemeInputStyle" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-muted">Last 4 digits of SSN</label>
                                <InputText @bind-Value="request.SSNLast4" class="form-control" maxlength="4" style="@ThemeInputStyle"
                                           placeholder="@(IsEditMode && HasSsnOnFile ? "On file - leave blank to keep" : null)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-muted">Next follow-up date</label>
                                <InputDate @bind-Value="request.NextFollowupDate" class="form-control" style="@ThemeInputStyle" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-4">
                                <label class="form-label small fw-bold text-muted">How many people are in the household?</label>
                                <InputNumber @bind-Value="request.HouseholdCount" class="form-control" style="@ThemeInputStyle" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-bold text-muted">How stable is the situation? (1-10)</label>
                                <InputSelect @bind-Value="request.StabilityScore" class="form-select" style="@ThemeInputStyle">
                                    @for (int i = 1; i <= 10; i++)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-bold text-muted">Current stage</label>
                                <InputSelect @bind-Value="request.LifePhase" class="form-select" style="@ThemeInputStyle">
                                    <option value="@LifePhase.Crisis">Crisis</option>
                                    <option value="@LifePhase.Stable">Stable</option>
                                    <option value="@LifePhase.Thriving">Thriving</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-muted">Marital status</label>
                                <InputSelect @bind-Value="request.MaritalStatus" class="form-select" style="@ThemeInputStyle">
                                    @foreach (var status in Enum.GetValues<MaritalStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-muted">Employment status</label>
                                <InputSelect @bind-Value="request.EmploymentStatus" class="form-select" style="@ThemeInputStyle">
                                    @foreach (var status in Enum.GetValues<EmploymentStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-muted">Role in household</label>
                                <InputSelect @bind-Value="request.HouseholdRole" class="form-select" style="@ThemeInputStyle">
                                    @foreach (var role in Enum.GetValues<HouseholdRole>())
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3" style="border-color: var(--growit-border);">
                            <button type="button" class="btn btn-outline-secondary" @onclick="Close">Cancel</button>
                            <button type="submit" class="btn btn-primary fw-bold">
                                <span class="oi oi-check me-2"></span>@(IsEditMode ? "Save Changes" : "Save Profile")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public EventCallback OnClientAdded { get; set; }

    // Edit mode: set both to change an existing person instead of adding one. The profile page
    // had no way to correct a name, update contact details, or move someone out of "Crisis".
    [Parameter] public Guid? EditClientId { get; set; }
    [Parameter] public CreateClientRequest? EditValues { get; set; }
    // The SSN digits are never sent back to the browser, so the field starts empty when editing.
    [Parameter] public bool HasSsnOnFile { get; set; }

    private bool IsEditMode => EditClientId.HasValue;

    private CreateClientRequest request = new();
    private bool wasShown;
    private string errorMessage = ""; // Surface API failures inline instead of faulting the circuit.
    private string ThemeInputStyle => "background-color: var(--growit-bg-primary); color: var(--growit-text-primary); border: 1px solid var(--growit-border);";

    protected override void OnParametersSet()
    {
        // Start from a clean form (or the person being edited) each time the modal opens.
        var justOpened = Show && !wasShown;
        wasShown = Show;
        if (!justOpened)
        {
            return;
        }

        errorMessage = "";
        request = IsEditMode && EditValues is not null
            ? EditValues
            : new CreateClientRequest
            {
                HouseholdCount = 1,
                StabilityScore = 5,
                LifePhase = LifePhase.Crisis
            };
    }

    private async Task HandleSubmit()
    {
        errorMessage = "";
        try
        {
            if (IsEditMode)
            {
                await ClientService.UpdateClientAsync(EditClientId!.Value, request);
                await OnClientAdded.InvokeAsync();
                await Close();
                return;
            }

            var clientId = await ClientService.CreateClientAsync(request);
            if (clientId != Guid.Empty)
            {
                request = new CreateClientRequest();
                await OnClientAdded.InvokeAsync();
                await Close();
            }
            else
            {
                errorMessage = "We couldn't save this person. Please check the details and try again.";
            }
        }
        catch (Exception ex)
        {
            // Without this, an API failure escapes the EditForm submit handler and, with no
            // ErrorBoundary above the page, tears down the whole circuit.
            errorMessage = ex is ApiException ? ex.Message : "We couldn't save this person. Please try again.";
        }
    }

    private async Task Close()
    {
        wasShown = false;
        await ShowChanged.InvokeAsync(false);
    }
}
