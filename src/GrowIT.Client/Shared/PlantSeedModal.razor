@using GrowIT.Shared.DTOs
@inject IClientService ClientService
@inject IFinancialService FinancialService
@inject IInvestmentService InvestmentService
@inject NavigationManager NavManager

@if (Show)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            
            <div class="modal-content border-0 shadow-lg" 
                 style="background-color: var(--growit-bg-card); color: var(--growit-text-primary);">
                
                <div class="modal-header" style="border-bottom: 1px solid var(--growit-border);">
                    <div>
                        <h5 class="modal-title fw-bold mb-1" style="color: var(--growit-text-primary);">
                            <span class="oi oi-briefcase me-2" style="color: var(--growit-green);"></span>New Service Record
                        </h5>
                        <p class="mb-0 small text-uppercase fw-bold" style="color: var(--growit-text-secondary);">Saved for reports and portfolio content</p>
                    </div>
                    <button type="button" class="btn btn-link text-decoration-none" style="color: var(--growit-text-muted);" @onclick="Close">
                        <span class="oi oi-x fs-5"></span>
                    </button>
                </div>

                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-3 border-0" role="alert" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545;">
                            <span class="oi oi-warning me-2 fs-5"></span>
                            <div class="small fw-bold">@errorMessage</div>
                        </div>
                    }

                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border" style="color: var(--growit-green);" role="status"></div>
                            <p class="mt-2 small" style="color: var(--growit-text-secondary);">Loading saved people, programs, and money sources...</p>
                        </div>
                    }
                    else if (MissingSetup.Count > 0 && string.IsNullOrEmpty(errorMessage))
                    {
                        @* A service record links a person, a program and a money source. On a new
                           workspace those lists are empty, and the form used to open as three blank
                           dropdowns with no way forward. Say what is missing and link to it. *@
                        <div class="seed-setup-needed">
                            <h6 class="fw-bold mb-1" style="color: var(--growit-text-primary);">A few things to add first</h6>
                            <p class="small mb-3" style="color: var(--growit-text-secondary);">
                                A service record connects a person, a program, and the money that paid for it.
                                Add what's missing below, then come back to record the service.
                            </p>
                            <ul class="list-unstyled mb-0 d-grid gap-2">
                                @foreach (var step in SetupSteps)
                                {
                                    <li class="d-flex align-items-center justify-content-between gap-3 p-3 rounded-3"
                                        style="border: 1px solid var(--growit-border); background-color: var(--growit-bg-primary);">
                                        <span class="d-flex align-items-center gap-2">
                                            <i class="bi @(step.Done ? "bi-check-circle-fill" : "bi-circle")" style="color: @(step.Done ? "var(--growit-green)" : "var(--growit-text-muted)");" aria-hidden="true"></i>
                                            <span>
                                                <span class="fw-bold d-block" style="color: var(--growit-text-primary);">@step.Title</span>
                                                <span class="small" style="color: var(--growit-text-secondary);">@(step.Done ? "Added" : step.Help)</span>
                                            </span>
                                        </span>
                                        @if (!step.Done)
                                        {
                                            <a class="btn btn-sm fw-bold text-white flex-shrink-0" style="background-color: var(--growit-green); border: none;"
                                               href="@step.Href" @onclick="Close">@step.Action</a>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="d-flex justify-content-end mt-4 pt-3" style="border-top: 1px solid var(--growit-border);">
                            <button type="button" class="btn btn-outline-secondary px-4"
                                    style="color: var(--growit-text-primary); border-color: var(--growit-border);"
                                    @onclick="Close">Close</button>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="@request" OnValidSubmit="HandleValidSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger small mb-2" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-uppercase" style="color: var(--growit-text-secondary);">Who received support?</label>
                                    <select class="form-select" style="@ThemeInputStyle" 
                                            value="@request.ClientId" 
                                            @onchange="OnClientChanged">
                                        <option value="@Guid.Empty">Select a person or household</option>
                                        @foreach (var c in clients) { <option value="@c.Id">@c.Name</option> }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-uppercase" style="color: var(--growit-text-secondary);">Specific household member (optional)</label>
                                    <InputSelect @bind-Value="request.FamilyMemberId" class="form-select" style="@ThemeInputStyle" disabled="@(!members.Any())">
                                        <option value="">Entire household</option>
                                        @foreach (var m in members) { <option value="@m.Id">@m.Name (@m.Relationship)</option> }
                                    </InputSelect>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-uppercase" style="color: var(--growit-text-secondary);">Which program or service?</label>
                                    <select class="form-select" style="@ThemeInputStyle"
                                            value="@request.ProgramId"
                                            @onchange="OnProgramChanged">
                                        <option value="@Guid.Empty">Select a program</option>
                                        @foreach (var p in programs) { <option value="@p.Id">@p.Name</option> }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-uppercase" style="color: var(--growit-text-secondary);">Which money source paid for it?</label>
                                    <InputSelect @bind-Value="request.FundId" class="form-select" style="@ThemeInputStyle">
                                        <option value="@Guid.Empty">Select a money source</option>
                                        @foreach (var f in funds) { <option value="@f.Id">@f.Name ($@f.AvailableAmount.ToString("N0"))</option> }
                                    </InputSelect>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-uppercase" style="color: var(--growit-text-secondary);">How much did it cost?</label>
                                    <div class="input-group">
                                        <span class="input-group-text fw-bold" 
                                              style="background-color: var(--growit-bg-primary); border-color: var(--growit-border); color: var(--growit-green);">$</span>
                                        <InputNumber @bind-Value="request.Amount" class="form-control fw-bold" placeholder="0.00" style="@ThemeInputStyle" />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-uppercase" style="color: var(--growit-text-secondary);">Who was paid? (Optional)</label>
                                    <InputText @bind-Value="request.PayeeName" class="form-control" placeholder="e.g. Entergy" style="@ThemeInputStyle" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label small fw-bold text-uppercase" style="color: var(--growit-text-secondary);">What happened?</label>
                                    <div class="form-text mb-2" style="color: var(--growit-text-muted);">Write this in your own words. grow.IT can reuse it later for reports and funding narratives.</div>
                                    <InputTextArea @bind-Value="request.Reason" class="form-control" rows="2" style="@ThemeInputStyle" />
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4 pt-3" style="border-top: 1px solid var(--growit-border);">
                                <button type="button" class="btn btn-outline-secondary px-4" 
                                        style="color: var(--growit-text-primary); border-color: var(--growit-border);" 
                                        @onclick="Close">Cancel</button>
                                <button type="submit" class="btn px-4 shadow-sm fw-bold text-white" 
                                        style="background-color: var(--growit-green); border: none;">
                                    <span class="oi oi-check me-2"></span>Save Service Record
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public EventCallback OnSeedPlanted { get; set; }

    private CreateInvestmentRequest request = new();
    private List<ClientDto> clients = new();
    private List<FundDto> funds = new();
    private List<ProgramDto> programs = new();
    private List<FamilyMemberDto> members = new();
    private bool isLoading = true;
    private bool wasShown;
    private string errorMessage = ""; // Holds any API error so the modal shows it inline instead of faulting the circuit.

    private sealed record SetupStep(string Title, string Help, string Action, string Href, bool Done);

    private List<SetupStep> SetupSteps =>
    [
        new("A person or household", "Who received the support.", "Add a person", "/clients", clients.Any()),
        new("A program or service", "What your organization provided.", "Add a program", "/programs", programs.Any()),
        new("A money source", "The grant, donation, or budget that paid for it.", "Add a money source", "/funds", funds.Any())
    ];

    private List<SetupStep> MissingSetup => SetupSteps.Where(s => !s.Done).ToList();

    private string ThemeInputStyle => "background-color: var(--growit-bg-primary); color: var(--growit-text-primary); border: 1px solid var(--growit-border);";

    protected override async Task OnParametersSetAsync()
    {
        // Reload every time the modal opens. It is mounted once for the whole app, so loading
        // only "when there are no people yet" left the program and money-source lists stale
        // (or empty) for anything added after the first open.
        var justOpened = Show && !wasShown;
        wasShown = Show;

        if (justOpened)
        {
            isLoading = true;
            errorMessage = "";
            try
            {
                var fundsTask = FinancialService.GetFundsAsync();
                var programsTask = FinancialService.GetProgramsAsync();
                var clientsTask = ClientService.GetAllClientsAsync();

                await Task.WhenAll(clientsTask, fundsTask, programsTask);

                clients = await clientsTask;
                funds = await fundsTask;
                programs = await programsTask;
            }
            catch (Exception ex)
            {
                // Surface the failure in-modal instead of letting it escape the lifecycle
                // handler and tear down the circuit (this modal is mounted app-wide).
                errorMessage = ex is ApiException ? ex.Message : "We couldn't load the saved people, programs, and money sources. Please try again.";
            }
            finally { isLoading = false; }
        }
    }

    private async Task OnClientChanged(ChangeEventArgs e)
    {
        var clientIdRaw = e.Value?.ToString();
        if (Guid.TryParse(clientIdRaw, out var clientId))
        {
            request.ClientId = clientId;
            request.FamilyMemberId = null; // Clear individual if family changes

            try
            {
                // Fetch client detail to get household members
                var detail = await ClientService.GetClientDetailAsync(clientId);
                members = detail?.HouseholdMembers ?? new();
            }
            catch (Exception ex)
            {
                members.Clear();
                errorMessage = ex is ApiException ? ex.Message : "We couldn't load that person's household. Please try again.";
            }
        }
        else
        {
            request.ClientId = Guid.Empty;
            request.FamilyMemberId = null;
            members.Clear();
        }
    }

    private void OnProgramChanged(ChangeEventArgs e)
    {
        request.ProgramId = Guid.TryParse(e.Value?.ToString(), out var programId) ? programId : Guid.Empty;

        // Start from the program's usual cost when no amount has been typed yet.
        if (request.Amount == 0)
        {
            var program = programs.FirstOrDefault(p => p.Id == request.ProgramId);
            if (program is { DefaultUnitCost: > 0 })
            {
                request.Amount = program.DefaultUnitCost;
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        errorMessage = "";
        try
        {
            var investmentId = await InvestmentService.CreateInvestmentAsync(request);
            if (investmentId != Guid.Empty)
            {
                await Close();
                await OnSeedPlanted.InvokeAsync();
            }
            else
            {
                errorMessage = "We couldn't save the service record. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex is ApiException ? ex.Message : "We couldn't save the service record. Please try again.";
        }
    }

    private async Task Close()
    {
        Show = false;
        wasShown = false;
        request = new();
        members.Clear();
        errorMessage = "";
        await ShowChanged.InvokeAsync(false);
    }
}
